PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/getclaim_db
JWT_SECRET=replace_with_a_new_random_secret_of_at_least_32_bytes
CLIENT_URL=http://localhost:5173
NODE_ENV=development
TRUST_PROXY_HOPS=0
EMAIL_TRANSPORT=console
SMS_TRANSPORT=console
STORAGE_DRIVER=local
# Production: set STORAGE_DRIVER=s3 and configure durable object storage.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
