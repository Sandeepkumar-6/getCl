{
  "name": "getclaim-mern",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install",
    "setup": "npm install && npm run seed",
    "preseed": "node scripts/init-env.js",
    "seed": "npm run seed -w server",
    "predev": "node scripts/init-env.js",
    "dev": "concurrently -k -n API,WEB -c cyan,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "lint": "eslint .",
    "test": "npm run test -w server",
    "db:demo": "node scripts/demo-db.js",
    "db:verify": "node scripts/verify-db.js",
    "test:browser": "node scripts/browser-smoke.js",
    "format": "prettier --write client/src server/src server/test scripts *.js *.json client/*.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "globals": "^16.5.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "@playwright/test": "^1.55.0",
    "prettier": "^3.6.2"
  }
}
